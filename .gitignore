# IDEs locales y archivos de contexto
/.idea/**
/.vscode/**
/CLAUDE.md
/.env
/*.local.env

# ==============================================================================
# REGLAS PARA SUBIR EL ÁRBOL DE CARPETAS SIN CONTENIDO (SÓLO .gitkeep)
# ==============================================================================

# Casa, CasaOS y Cloudflare Tunnel
/casa/*
!/casa/.gitkeep
/casaos/*
!/casaos/.gitkeep
/cloudflare-tunnel/*
!/cloudflare-tunnel/.gitkeep

# Nextcloud, PhotoPrism, Transmission y Users
/nextcloud/*
!/nextcloud/.gitkeep
/photoprism/*
!/photoprism/.gitkeep
/transmission/*
!/transmission/.gitkeep
/users/*
!/users/.gitkeep

# Jellyfin (subcarpetas config y cache)
/jellyfin/*
!/jellyfin/config/
!/jellyfin/cache/
/jellyfin/config/*
!/jellyfin/config/.gitkeep
/jellyfin/cache/*
!/jellyfin/cache/.gitkeep

# Jellyseerr (subcarpeta db)
/jellyseerr/*
!/jellyseerr/db/
/jellyseerr/db/*
!/jellyseerr/db/.gitkeep

# Prowlarr, qBittorrent, Radarr, Sonarr (subcarpeta config)
/prowlarr/*
!/prowlarr/config/
/prowlarr/config/*
!/prowlarr/config/.gitkeep

/qbittorrent/*
!/qbittorrent/config/
/qbittorrent/config/*
!/qbittorrent/config/.gitkeep

/radarr/*
!/radarr/config/
/radarr/config/*
!/radarr/config/.gitkeep

/sonarr/*
!/sonarr/config/
/sonarr/config/*
!/sonarr/config/.gitkeep

# Media (subcarpetas de películas, series, descargas, etc.)
/media/*
!/media/peliculas/
!/media/series/
!/media/descargas/
!/media/fotos/
!/media/incomplete/
!/media/watch/

/media/peliculas/*
!/media/peliculas/.gitkeep
/media/series/*
!/media/series/.gitkeep
/media/descargas/*
!/media/descargas/.gitkeep
/media/fotos/*
!/media/fotos/.gitkeep
/media/incomplete/*
!/media/incomplete/.gitkeep
/media/watch/*
!/media/watch/.gitkeep

# ==============================================================================
# EXCEPCIONES GENERALES (ARCHIVOS DE CONFIGURACIÓN DEL REPO)
# ==============================================================================
!.gitignore
!docker-compose.yml
!iniciar.sh
!home-cloud-server.README.md
!home-cloud-server.env

# Plantillas públicas
!/config-templates/**
